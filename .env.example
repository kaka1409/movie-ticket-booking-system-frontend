# Backend API origin — read server-side by src/libs/api.ts and at build time by
# next.config.ts rewrites(). REQUIRED in production: src/instrumentation.ts
# validates it at boot and a production server without it fails to start.
BACKEND_URL=http://localhost:8080

# API path prefix. Must match the rewrite source in next.config.ts.
API_PREFIX=/api/v1

# Public site origin — used by SEO metadata (metadataBase, OG/Twitter URLs,
# robots.ts, sitemap.ts). Set to the real domain before `pnpm build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra allowed dev origins (comma-separated hostnames/IPs) merged into
# next.config.ts `allowedDevOrigins` — add your machine's LAN IP when testing
# from another device on the network. Dev-only; ignored in production.
ALLOWED_DEV_ORIGINS=

# Backend origin for the notification Socket.IO connection (browser). Next
# rewrites proxy REST but cannot upgrade WebSockets, so the client dials the API
# directly.
#   unset + development -> http://<page-hostname>:8080 (follows LAN/IP access)
#   unset + production  -> realtime off; the REST inbox still works
# Set it whenever the API is on another host than the site (always true on
# Vercel), otherwise notifications fall back to polling-on-load.
NEXT_PUBLIC_BACKEND_URL=
