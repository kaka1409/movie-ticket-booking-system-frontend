# Backend API origin — used server-side by src/libs/api.ts AND at
# build time by next.config.ts rewrites(). Set before `pnpm build`.
BACKEND_URL=http://localhost:8080

# API path prefix
API_PREFIX=/api/v1

# Public site origin — used by SEO metadata (metadataBase, OG/Twitter URLs,
# robots.ts, sitemap.ts). Set to the real domain before `pnpm build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra allowed dev origins (comma-separated hostnames/IPs) merged into
# next.config.ts `allowedDevOrigins` — add your machine's LAN IP when testing
# from another device on the network. Dev-only; ignored in production.
ALLOWED_DEV_ORIGINS=

# Backend origin for the notification Socket.IO connection (browser). Next
# rewrites proxy REST but cannot upgrade WebSockets, so the client dials the
# API directly. Defaults to http://<page-hostname>:8080 when unset, which
# follows LAN/IP access automatically; set this only when the API lives on a
# different host than the page (e.g. production).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
